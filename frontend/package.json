{
  "name": "frontend",
  "private": true,
  "version": "1.46.1",
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/security-headers.mjs",
    "lint": "oxlint . -D no-unused-vars && node scripts/check-color-tokens.mjs",
    "check:colors": "node scripts/check-color-tokens.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "node scripts/run-test-suite.mjs unit",
    "test:integration": "node scripts/run-test-suite.mjs integration",
    "test:coverage:unit": "node scripts/run-test-suite.mjs unit --coverage",
    "test:coverage:integration": "node scripts/run-test-suite.mjs integration --coverage",
    "test:allure:unit": "node scripts/run-allure-suite.mjs unit",
    "test:allure:integration": "node scripts/run-allure-suite.mjs integration",
    "allure:generate": "node scripts/run-allure-suite.mjs generate",
    "allure:open": "node scripts/run-allure-suite.mjs open",
    "test:single": "vitest --run --testNamePattern",
    "test:coverage:open": "vitest run --coverage && start coverage/combined/index.html",
    "demo:apoderado": "powershell -ExecutionPolicy Bypass -File scripts/run-apoderado-demo.ps1",
    "demo:apoderado:ui": "playwright test -c playwright.demo.config.ts --headed"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.5.0",
    "axios": "^1.21.0",
    "html-to-image": "^1.11.13",
    "lottie-react": "^3.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/runner": "4.1.11",
    "allure": "3.33.0",
    "allure-js-commons": "3.14.0",
    "allure-vitest": "3.14.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.11"
  }
}
