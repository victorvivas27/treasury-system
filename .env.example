APP_PROFILE=dev
PORT=5055

DB_HOST=postgres
DB_PORT=5432
DB_NAME=tesoreria_db
DB_USER=postgres
DB_PASSWORD=change-me

# Production should normally keep validate and use migrations/schema managed externally.
JPA_DDL_AUTO=validate
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.trycloudflare.com
APP_CORS_OFFICIAL_ORIGINS=https://tesoreriaescolar.app,https://www.tesoreriaescolar.app

# Frontend
VITE_API_URL=http://localhost:5055/tesoreria/api/v1
VITE_SITE_URL=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-characters-for-production
ADMIN_BOOTSTRAP_KEY=define-a-long-random-one-time-bootstrap-key
JWT_EXPIRATION_MS=1800000
REFRESH_TOKEN_EXPIRATION_SECONDS=2592000
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
TREASURY_MANAGED_COURSE=1A
EMAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Tesorería Escolar <tesoreria.colegio@gmail.com>
FRONTEND_URL=http://localhost:5173
WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:tesoreria@example.com
GCS_ENABLED=false
GCS_BUCKET_NAME=
GCS_MAX_FILE_SIZE_MB=10

# Checkout Pro dentro de /tesoreria/pagos (solo servidor; ver docs/MERCADO_PAGO.md)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ORGANIZATION_ID=0
MERCADO_PAGO_COLLECTOR_ID=
MERCADO_PAGO_RETURN_URL=
MERCADO_PAGO_WEBHOOK_URL=
MERCADO_PAGO_TEST_MODE=true
