#!/usr/bin/env sh
set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  if [ -n "$remote_sha" ] && [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
    commits=$(git rev-list "$local_sha" "^$remote_sha")
  else
    commits=$(git rev-list "$local_sha" --not --remotes)
  fi
  for commit in $commits; do
    node "$(git rev-parse --show-toplevel)/scripts/validate-commit-message.cjs" --commit "$commit"
  done
done
