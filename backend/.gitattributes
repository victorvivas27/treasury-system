# Normalize text files
* text=auto

# Java and configuration files use LF
*.java text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# Gradle files use LF
*.gradle text eol=lf
*.gradle.kts text eol=lf

# Shell scripts use LF
*.sh text eol=lf

# Windows scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
