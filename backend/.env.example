DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_db
DB_USER=usuario
DB_PASSWORD=tu_password
APP_PROFILE=dev
PORT=5055
JWT_SECRET=replace-with-at-least-32-characters-for-production-ejemplo
JWT_EXPIRATION_MS=2592000000
ADMIN_BOOTSTRAP_KEY=define-a-long-random-one-time-bootstrap-key
TREASURY_MANAGED_COURSE=1A
EMAIL_PROVIDER=gmail
# To enable Resend: EMAIL_PROVIDER=resend and a verified-domain EMAIL_FROM.
# Example sender after domain verification: Tesorería Escolar <invitaciones@tesoreriaescolar.app>
# Cloud Run: bind RESEND_API_KEY from Secret Manager; never put it in the frontend.
RESEND_API_KEY=
# Signing secret (whsec_) for POST /tesoreria/api/v1/email/resend/webhook.
# Subscribe: email.sent, email.delivered, email.delivery_delayed, email.bounced,
# email.failed, email.suppressed, email.complained. Store in Secret Manager on GCP.
RESEND_WEBHOOK_SECRET=
EMAIL_REPLY_TO=treasury.system.app@gmail.com
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Tesorería Escolar <tesoreria.colegio@gmail.com>
FRONTEND_URL=http://localhost:5173
# Temporary bridge; enable only after publishing the fragment-compatible frontend.
ACCOUNT_LINK_USE_FRAGMENT=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
APP_CORS_OFFICIAL_ORIGINS=https://tesoreriaescolar.app,https://www.tesoreriaescolar.app
GCS_ENABLED=false
GCS_BUCKET_NAME=
GCS_MAX_FILE_SIZE_MB=10
WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:tesoreria@example.com
