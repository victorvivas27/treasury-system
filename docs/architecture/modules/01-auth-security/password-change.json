  "cards": [
    {
      "dot": "emerald",
      "title": "Transacción única",
      "items": [
        "Contraseña, marca persistente y revocación se confirman juntas por userId.",
        "Si contraseña/validación/correo falla, se rechaza; las escrituras de BD se revierten."
      ]
    },
    {
      "dot": "cyan",
      "title": "Efecto observable",
      "items": [
        "Refresh anterior se rechaza; JWT con familia pierde acceso porque no existe sucesor activo.",
        "JWT anterior sin familia se compara con sessions_revoked_at. No se borra una cookie remota de otro navegador."
      ]
    },
    {
      "dot": "cyan",
      "title": "Acciones internas",
      "items": [
        "Validar actual; nueva válida y diferente"
      ]
    }
